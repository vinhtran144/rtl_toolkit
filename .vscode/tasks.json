{
  "version" : "2.0.0",
  "tasks" : [
    {
      "label" : "Update Toolkit",
      "type" : "shell",
      "command" : "scala run ${workspaceFolder}/scripts/toolkit_updater.scala",
      "problemMatcher" : [
      ],
      "group" : {
        "kind" : "build",
        "isDefault" : false
      },
      "presentation" : {
        "echo" : true,
        "reveal" : "always",
        "focus" : false
      }
    },
    {
      "label" : "Toolkit: Execute scripts",
      "type" : "shell",
      "command" : "scala run ${workspaceFolder}/scripts/${input:execScriptName}.scala -- ${fileDirname}",
      "group" : {
        "kind" : "build",
        "isDefault" : false
      },
      "problemMatcher" : [
      ],
      "presentation" : {
        "echo" : true,
        "reveal" : "always",
        "focus" : true,
        "panel" : "shared"
      }
    },
    {
      "label" : "Toolkit: Generate components",
      "type" : "shell",
      "command" : "scala run ${workspaceFolder}/scripts/gen_${input:genScriptName}.scala -- ${fileDirname} ${input:projectName}",
      "group" : {
        "kind" : "build",
        "isDefault" : false
      },
      "problemMatcher" : [
      ],
      "presentation" : {
        "echo" : true,
        "reveal" : "always",
        "focus" : true,
        "panel" : "shared"
      }
    },{
      "label" : "Toolkit: Generate components proto",
      "type" : "shell",
      "command" : "scala",
      "args": [
        "run",
        "${workspaceFolder}/utils/script_runner.scala",
        "--",
        "true",
        "${input:genScriptName}",
        "${workspaceFolder}",
        "${fileDirname}",
        "${input:projectName}"
      ],
      "group" : {
        "kind" : "build",
        "isDefault" : false
      },
      "problemMatcher" : [
      ],
      "presentation" : {
        "echo" : true,
        "reveal" : "always",
        "focus" : true,
        "panel" : "shared"
      }
    }
  ],
  "inputs" : [
    {
      "id" : "execScriptName",
      "type" : "pickString",
      "description" : "Select execute script to run:",
      "options" : [
        "dir_test",
        "toolkit_updater"
      ]
    },
    {
      "id" : "genScriptName",
      "type" : "pickString",
      "description" : "Select generation script to run:",
      "options" : [
        "sv_interface"
      ]
    },
    {
      "id" : "projectName",
      "type" : "promptString",
      "description" : "Enter new project name:",
      "default" : "new_project"
    }
  ]
}